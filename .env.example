# Copy this file to .env.local and fill in real values from your
# Supabase project (Settings -> API, and Settings -> API -> Project URL).
# Never commit .env.local — it's already in .gitignore.

# Safe to expose to the browser (Supabase's anon key is designed for
# this — Row-Level Security, not secrecy, is what protects your data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used for email confirmation / password-reset redirect links. Your
# local dev URL, or your real Vercel URL once deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_, never import this
# from a "use client" file, never log it. Bypasses every RLS policy —
# only used by lib/supabase/server.ts's createServiceRoleClient(),
# which is reserved for the one-time migration import script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
